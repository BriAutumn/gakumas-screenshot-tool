@echo off
setlocal DisableDelayedExpansion
set "GK_EXPORT_DIAG_OUT=%~dp0GKMemoryExport-diagnostic-v3.txt"
set "GK_DIAG_PS=%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe"
if exist "%SystemRoot%\Sysnative\WindowsPowerShell\v1.0\powershell.exe" set "GK_DIAG_PS=%SystemRoot%\Sysnative\WindowsPowerShell\v1.0\powershell.exe"
"%GK_DIAG_PS%" -NoProfile -Command "$lines = New-Object System.Collections.Generic.List[string]; function Add-Line([string]$value) { $lines.Add($value) }; Add-Line 'GKMemoryTool export diagnostic V3 (read-only; no memory/account export)'; Add-Line ('Time: ' + (Get-Date -Format o)); Add-Line ('64-bit diagnostic: ' + [Environment]::Is64BitProcess); Add-Line ('LOCALAPPDATA: ' + $env:LOCALAPPDATA); Add-Line ('OS: ' + [Environment]::OSVersion.VersionString); Add-Line ('Elevated: ' + ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)); try {;     $native = 'using System; using System.Text; using System.Runtime.InteropServices; public static class GKExportPathProbe { [DllImport(~kernel32.dll~, SetLastError=true)] static extern IntPtr OpenProcess(uint access, bool inherit, uint id); [DllImport(~kernel32.dll~, SetLastError=true, CharSet=CharSet.Unicode)] static extern bool QueryFullProcessImageName(IntPtr h, uint flags, StringBuilder b, ref uint size); [DllImport(~kernel32.dll~)] static extern bool CloseHandle(IntPtr h); public static string Read(uint id, out int error) { var h=OpenProcess(0x1000,false,id); if(h==IntPtr.Zero) { error=Marshal.GetLastWin32Error(); return null; } var b=new StringBuilder(32768); uint n=32768; bool ok=QueryFullProcessImageName(h,0,b,ref n); error=ok?0:Marshal.GetLastWin32Error(); CloseHandle(h); return ok?b.ToString():null; } }';     Add-Type -TypeDefinition $native.Replace('~',[char]34) -ErrorAction Stop; } catch { Add-Line ('Limited process query setup error: ' + $_.Exception.Message) }; $roots = New-Object System.Collections.Generic.List[string]; $roots.Add((Join-Path $env:LOCALAPPDATA 'GKMemoryTool')); $games = @(Get-Process -Name gakumas -ErrorAction SilentlyContinue); Add-Line ('Running game processes: ' + $games.Count); foreach ($game in $games) {;     Add-Line ('Game PID: ' + $game.Id);     try { Add-Line ('Game start time: ' + $game.StartTime.ToString('o')) } catch { Add-Line 'Game start time unavailable' };     try {;         $exe = $null;         try { $exe = $game.MainModule.FileName } catch { Add-Line ('MainModule query error: ' + $_.Exception.Message) };         if (-not $exe) {;             try {;                 $queryError = 0;                 $exe = [GKExportPathProbe]::Read([uint32]$game.Id,[ref]$queryError);                 Add-Line ('Limited process query Win32 error: ' + $queryError);             } catch { Add-Line ('Limited process query error: ' + $_.Exception.Message) };         };         if (-not $exe) {;             Add-Line 'Game path query unavailable; inspecting reported installation directory instead';             if (Test-Path -LiteralPath 'D:\DMM\gakumas\gakumas.exe' -PathType Leaf) { $exe = 'D:\DMM\gakumas\gakumas.exe' };         };         if (-not $exe) { throw 'Game executable path unavailable; reported directory also not found' };         Add-Line ('Game executable: ' + $exe);         $directory = Split-Path -LiteralPath $exe;         foreach ($name in @('version.dll', 'winhttp.dll', 'GKMemoryExport.ini')) {;             $path = Join-Path $directory $name;             if (Test-Path -LiteralPath $path -PathType Leaf) {;                 Add-Line ('Installed file: ' + $path);                 Add-Line ('SHA256: ' + (Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash);                 if ($name -eq 'GKMemoryExport.ini') {;                     $config = Get-Content -LiteralPath $path -Raw;                     $match = [regex]::Match($config, '(?m)^\s*ExportDirectory\s*=\s*(.+?)\s*$');                     if ($match.Success) {;                         $export = $match.Groups[1].Value.Trim();                         Add-Line ('Configured export: ' + $export);                         Add-Line ('Export folder exists: ' + (Test-Path -LiteralPath $export -PathType Container));                         if ([IO.Path]::IsPathRooted($export)) { $roots.Add((Split-Path -LiteralPath $export)) };                     } else { Add-Line 'ExportDirectory not found in config' };                 };             } else { Add-Line ('Missing installed file: ' + $path) };         };     } catch { Add-Line ('Game path/config inspection error: ' + $_.Exception.Message) }; ; }; foreach ($root in @($roots | Select-Object -Unique)) {;     Add-Line ('Data root: ' + $root);     foreach ($name in @('native-export\status.json','native-export\export-diagnostic.log','loader-diagnostic.log','last-error.txt','plugin-action-result.json')) {;         $path = Join-Path $root $name;         if (Test-Path -LiteralPath $path -PathType Leaf) {;             $file = Get-Item -LiteralPath $path;             Add-Line ('Diagnostic file: ' + $path + ' | Modified: ' + $file.LastWriteTime.ToString('o'));             if ($file.Length -le 262144) { Add-Line (Get-Content -LiteralPath $path -Raw) } else { Add-Line 'File too large; contents omitted' };         } else { Add-Line ('Missing diagnostic file: ' + $path) };     }; }; Add-Line 'No game files were changed. No memories.json, passwords or tokens collected.'; $destination = $env:GK_EXPORT_DIAG_OUT; if (-not $destination) { throw 'Missing diagnostic output path' }; $lines | Set-Content -LiteralPath $destination -Encoding UTF8; Write-Host ('Saved report: ' + $destination)"
pause
